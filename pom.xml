<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.apache</groupId>
    <artifactId>apache</artifactId>
    <version>38</version>
  </parent>

  <groupId>io.github.aggarwal-raghav</groupId>
  <artifactId>java-archetype</artifactId>
  <version>1.0</version>
  <packaging>maven-archetype</packaging>
  <name>Java Archetype</name>

  <description>A maven archetype project with basic style checks and possibility to publish to central.</description>
  <url>https://github.com/Aggarwal-Raghav/java-archetype</url>

  <licenses>
    <license>
      <name>The Apache License, Version 2.0</name>
      <url>http://www.apache.org/licenses/LICENSE-2.0.txt</url>
    </license>
  </licenses>

  <developers>
    <developer>
      <name>Raghav Aggarwal</name>
      <email>raghavaggarwal03.ra@gmail.com</email>
      <organizationUrl>https://aggarwal-raghav.github.io/</organizationUrl>
    </developer>
  </developers>

  <scm>
    <connection>scm:git:git://github.com/Aggarwal-Raghav/utils.git</connection>
    <developerConnection>scm:git:ssh://github.com:Aggarwal-Raghav/utils.git</developerConnection>
    <url>https://github.com/Aggarwal-Raghav/utils/tree/main</url>
  </scm>

  <distributionManagement>
    <repository>
      <id>sonatype-nexus-staging</id>
      <name>Nexus Release Repository</name>
      <url>https://oss.sonatype.org/service/local/staging/deploy/maven2</url>
    </repository>
    <snapshotRepository>
      <id>sonatype-nexus-snapshots</id>
      <name>Sonatype Nexus Snapshots</name>
      <url>https://oss.sonatype.org/content/repositories/snapshots</url>
    </snapshotRepository>
  </distributionManagement>

  <properties>
    <central.publishing.plugin.version>0.11.0</central.publishing.plugin.version>
    <google.java.format.version>1.36.1</google.java.format.version>
    <javaVersion>21</javaVersion>
    <maven.archetype.version>3.4.1</maven.archetype.version>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <spotless.version>3.8.0</spotless.version>
  </properties>

  <build>
    <plugins>
      <plugin>
        <groupId>com.diffplug.spotless</groupId>
        <artifactId>spotless-maven-plugin</artifactId>
        <version>${spotless.version}</version>

        <configuration>
          <java>
            <googleJavaFormat>
              <version>${google.java.format.version}</version>
              <style>GOOGLE</style>
            </googleJavaFormat>
            <removeUnusedImports/>
            <importOrder/>
            <licenseHeader>
              <file>style/java-header</file>
            </licenseHeader>
          </java>
          <markdown>
            <includes>
              <include>**/*.md</include>
            </includes>
            <flexmark/>
          </markdown>
          <pom>
            <includes>
              <include>pom.xml</include>
            </includes>
            <sortPom>
              <expandEmptyElements>false</expandEmptyElements>
              <sortDependencies/>
              <sortProperties>true</sortProperties>
            </sortPom>
            <licenseHeader>
              <file>style/xml-header</file>
              <delimiter>^&lt;project|^&lt;configuration|^&lt;Configuration|^&lt;extensions|^&lt;component</delimiter>
            </licenseHeader>
          </pom>
          <sql>
            <includes>
              <include>**/*.sql</include>
            </includes>
            <dbeaver>
              <configFile>style/dbeaver.properties</configFile>
            </dbeaver>
          </sql>
        </configuration>

      </plugin>
    </plugins>
    <extensions>
      <extension>
        <groupId>org.apache.maven.archetype</groupId>
        <artifactId>archetype-packaging</artifactId>
        <version>${maven.archetype.version}</version>
      </extension>
    </extensions>
  </build>

  <profiles>
    <profile>
      <id>release</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.sonatype.central</groupId>
            <artifactId>central-publishing-maven-plugin</artifactId>
            <version>${central.publishing.plugin.version}</version>
            <extensions>true</extensions>
            <configuration>
              <publishingServerId>central</publishingServerId>
              <autoPublish>false</autoPublish>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>

</project>
